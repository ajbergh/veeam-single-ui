VEEAM_API_URL=https://your-vbr-server:9419
VEEAM_USERNAME=your-username
VEEAM_PASSWORD=your-password

VRO_API_URL=https://your-vro-server:9898
VRO_USERNAME=your-vro-username
VRO_PASSWORD=your-vro-password

VBM_API_URL=https://your-vbm-server:4443
VBM_USERNAME=your-vbm-username
VBM_PASSWORD=your-vbm-password

VEEAM_ONE_API_URL="https://your-vone-server:1239"
VEEAM_ONE_USERNAME="your-vone-username"
VEEAM_ONE_PASSWORD="your-vone-password"

# Veeam self-signed certificates work automatically. Optional strict validation:
# VEEAM_TLS_VERIFY=1

# Read-only capacity history (15 minutes) and planning-cache refresh (30 minutes).
# Requires saved VBR credentials and persistent, writable data storage.
CAPACITY_COLLECTOR_ENABLED=true

# Optional server-to-server app origin behind a reverse proxy/container.
# Defaults to http://127.0.0.1:${PORT:-3000}; never set this to a public tunnel URL.
# INTERNAL_APP_URL=http://127.0.0.1:3000

# Optional built-in HTTPS (npm run start:https).
# Export these in the launcher process environment; do not commit real secrets.
# HTTPS_PORT=3443
# HTTPS_HOSTNAMES=backup.example.com,192.0.2.10
# HTTPS_ADMIN_TOKEN=<generate-a-random-secret-at-least-32-characters>
# OPENSSL_BIN=/path/to/openssl
